# Copy real values from Terraform outputs (or run scripts/gen_config.py).
# Values shown in angle brackets below are placeholders, not literal configuration values.
service: my-service
port: 8000
health_path: /health
task: {cpu: 1024, memory: 2048, app_cpu: 512}
scenario:
  profile: read-heavy-api
  rps: 20
  seconds: 30
  warmup_seconds: 5
  endpoints:
    - {path: /users, weight: 3, max_p95_ratio: 1.25, max_error_delta: 0.02}
    - {path: /orders, weight: 2, method: POST, body: {items: [{sku: demo, quantity: 1}]}}
scenarios:
  - profile: normal
    rps: 20
    seconds: 30
    warmup_seconds: 5
    endpoints:
      - {path: /users, weight: 3, max_p95_ratio: 1.25}
      - {path: /orders, weight: 2, method: POST, body: {items: [{sku: demo, quantity: 1}]}}
  - profile: spike
    rps: 80
    seconds: 30
    warmup_seconds: 5
    endpoints:
      - {path: /users, weight: 3, max_p95_ratio: 1.5}
      - {path: /orders, weight: 2, method: POST, body: {items: [{sku: demo, quantity: 1}]}}
thresholds: {alpha: 0.01, min_ratio: 1.25, min_agree: 2, error_abs: 0.02, cost_min_ratio: 1.15}
cost: {target_rps: 500, target_utilization: 0.6, on_cost_regression: warn}
pricing: {vcpu_hour: 0.0, gb_hour: 0.0}   # set from the AWS Fargate pricing page for your region
replicas: 3
max_probes: 24
bisect_k: 3
infra:   # generated by scripts/gen_config.py from terraform outputs
  region: ap-south-1
  cluster: bisectr
  log_group: /bisectr/probe
  exec_role: arn:aws:iam::<account>:role/bisectr-exec
  sg: sg-xxxxxxxx
  subnets: [subnet-aaaa, subnet-bbbb]
  image_repo: <account>.dkr.ecr.ap-south-1.amazonaws.com/bisectr-demo
  runner_image: <account>.dkr.ecr.ap-south-1.amazonaws.com/bisectr-runner:latest
  runs_table: bisectr-runs
  baseline_table: bisectr-baselines
  reports_bucket: bisectr-reports-<account>-ap-south-1
  budget_name: bisectr-monthly
